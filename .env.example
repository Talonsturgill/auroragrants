# AuroraGrants environment variables
# Copy to .env.local for web, .env for worker. Never commit real secrets.

# --- App ---
APP_ENV=development              # development | preview | production
APP_URL=http://localhost:3000
MARKETING_URL=http://localhost:3000
WORKER_URL=http://localhost:8080

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key — server only>
SUPABASE_JWT_SECRET=<jwt secret>

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app/onboarding

# --- LLM providers ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY_ZDR=sk-ant-...          # bound to a ZDR-enabled organization (Sovereignty deployments)
OPENAI_API_KEY=sk-...
GOOGLE_GENAI_API_KEY=...                  # Gemini fallback
COHERE_API_KEY=...

# Model pins (override in per-tenant llm_model_overrides when needed)
MODEL_WRITER=claude-sonnet-4-5
MODEL_CRITIC=claude-sonnet-4-5
MODEL_CRITIC_HIGH_STAKES=claude-opus-4-5
MODEL_EDITOR=claude-sonnet-4-5
MODEL_CLASSIFIER=claude-haiku-4-5

# --- Notifications ---
RESEND_API_KEY=re_...
POSTMARK_SERVER_TOKEN=...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...

# --- Worker JWT ---
WORKER_JWT_SECRET=<32+ byte random>       # shared between Next.js gateway and FastAPI worker

# --- Observability ---
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=auroragrants

# --- Parsing ---
LLAMAPARSE_API_KEY=                       # only if bake-off selects it
GOOGLE_DOCUMENT_AI_PROJECT=               # only if bake-off selects it

# --- Feature flags ---
FEATURE_SOVEREIGNTY_POSTURE_ENABLED=false # Sovereignty deployment posture (dedicated infra, BYOK, ZDR, TDUA). Not a paid tier.
FEATURE_PROPOSAL_DRAFTING_ENABLED=false   # ships v1.1
FEATURE_FUNDER_DISCOVERY_ENABLED=false    # ships v2

# --- Self-hosting budgets (each deployment sets its own) ---
DEFAULT_MONTHLY_TOKEN_BUDGET_CENTS=10000  # $100 per tenant per month default
ALERT_TOKEN_BUDGET_PCT=80
HARD_CAP_TOKEN_BUDGET_PCT=100
